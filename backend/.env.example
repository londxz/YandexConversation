APP_ENV=development
LOG_LEVEL=debug
HTTP_ADDRESS=:8080
API_PORT=8080
POSTGRES_PORT=5433
DATABASE_URL=postgres://razgovor:local-development-password@localhost:5433/razgovor?sslmode=disable

# Generate each value independently: openssl rand -base64 32
TOKEN_PEPPER_BASE64=
IDEMPOTENCY_ENCRYPTION_KEY_BASE64=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=2160h
IDEMPOTENCY_TTL=24h

# Free self-hosted speech recognition. No cloud key is required.
SPEECH_PROVIDER=whisper
WHISPER_ENDPOINT=http://127.0.0.1:8081/inference
SPEECH_RECOGNITION_TIMEOUT=20s
SPEECH_MAX_AUDIO_BYTES=1048576
SPEECH_MAX_DURATION=30s
SPEECH_SUPPORTED_LANGUAGES=ru-RU,en-US
SPEECH_MAX_CONCURRENT_REQUESTS=16
SPEECH_STREAM_PARTIAL_INTERVAL=2s
SPEECH_STREAM_SILENCE_DURATION=800ms
SPEECH_STREAM_MAX_SEGMENT_DURATION=15s
SPEECH_STREAM_MAX_CHUNK_BYTES=65536
SPEECH_STREAM_MAX_CONNECTIONS=32
SHUTDOWN_TIMEOUT=10s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=30s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_MAX_BODY_BYTES=26214400

DATABASE_CONNECT_TIMEOUT=5s
DATABASE_HEALTH_TIMEOUT=2s
DATABASE_MAX_CONNECTIONS=20
DATABASE_MIN_CONNECTIONS=2
DATABASE_MAX_CONN_LIFETIME=30m
DATABASE_MAX_CONN_IDLE_TIME=5m
